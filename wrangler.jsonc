{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "skoleai",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "skoleai"
    }
  ],
  // For production: run `wrangler secret put GEMINI_API_KEY` and enter your key
  // For local dev: use .dev.vars (copy from .dev.vars.example)
  "images": {
    "binding": "IMAGES"
  }
}
